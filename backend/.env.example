# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MySQL)
# Example format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# If your password contains special characters like @, encode them (e.g. @ becomes %40)
DATABASE_URL="mysql://root:password@localhost:3306/unimanager"

# JWT Secrets (Generate secure random strings in production)
JWT_ACCESS_SECRET="unimanager_access_super_secret_key_change_me!"
JWT_REFRESH_SECRET="unimanager_refresh_super_secret_key_change_me!"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# CORS Configuration
CLIENT_URL="http://localhost:5173"
